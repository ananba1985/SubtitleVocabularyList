{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SubtitleVocabularyList",
  "mainBinaryName": "SubtitleVocabularyList",
  "version": "0.26.8",
  "identifier": "com.subtitlevocabularylist.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SubtitleVocabularyList"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost blob:; connect-src ipc: http://ipc.localhost 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/media/**",
          "$APPDATA/jobs/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "licenseFile": "../LICENSE",
    "shortDescription": "离线剧集英语单词本"
  }
}
